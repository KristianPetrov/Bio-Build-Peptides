# Neon Postgres (provisioned by the Vercel Neon integration)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Sessions — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated. Registering or signing in with one of these grants admin.
ADMIN_EMAILS=""

# Manual payment destinations — a method appears at checkout only when set.
PAYMENT_ZELLE_RECIPIENT=""   # Zelle email or phone
PAYMENT_ZELLE_NAME=""        # optional display name, e.g. "Bio Build LLC"
PAYMENT_VENMO_HANDLE=""      # without @
PAYMENT_CASHAPP_CASHTAG=""   # without $
PAYMENT_LINK_URL=""          # Autobooks / Square hosted payment link
PAYMENT_LINK_LABEL=""        # e.g. "Autobooks" or "Square"
# Preview deployments only: list unconfigured methods for flow testing (no destination shown).
PAYMENTS_PREVIEW_MODE=""

# Public contact details (hidden when empty)
CONTACT_EMAIL=""
CONTACT_PHONE=""
NEXT_PUBLIC_SITE_URL=""      # e.g. https://www.biobuildpeptides.com

# Transactional email via Resend (emails are skipped when unset)
RESEND_API_KEY=""
EMAIL_FROM=""                # e.g. "Bio Build Peptides <orders@yourdomain.com>"
ORDER_NOTIFICATION_EMAIL=""  # admin copy of new orders
